# Copy to .env at repository root. Never commit real credentials.
# Both local APIs use this file. Keep Inventory and ShiftFlow credentials separate.
# ShiftFlow / Worktime
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Inventory / Order / Cleaning
INVENTORY_SUPABASE_URL=
INVENTORY_SUPABASE_SERVICE_ROLE_KEY=

# Leave (optional; the other apps boot when these are omitted)
LEAVE_SUPABASE_URL=
LEAVE_SUPABASE_SERVICE_ROLE_KEY=

# Shift Flow authentication
ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ORDER_ADMIN_PASSWORD=
ORDER_ADMIN_TOKEN_SECRET=
EMPLOYEE_PIN_SALT=
EMPLOYEE_TOKEN_SECRET=
ADMIN_STORE_ID=
WORKTIME_ADMIN_STORE_ID=
DEMO_WORKTIME_ADMIN_PASSWORD=

# Leave authentication
LEAVE_ADMIN_PASSWORD=
DEMO_LEAVE_ADMIN_PASSWORD=
LEAVE_ADMIN_TOKEN_SECRET=

# Public employee lookup / browser key (VITE_* values are public)
PUBLIC_EMPLOYEES_KEY=
VITE_PUBLIC_EMPLOYEES_KEY=

# Email (only required when sending)
RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=
